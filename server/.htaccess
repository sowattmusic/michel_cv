# michelgallone.ch — une seule adresse, adresses courtes, compression et cache

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # www -> sans www (https)
  RewriteCond %{HTTP_HOST} ^www\.michelgallone\.ch$ [NC]
  RewriteRule ^ https://michelgallone.ch%{REQUEST_URI} [R=301,L]
  # http -> https
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://michelgallone.ch%{REQUEST_URI} [R=301,L]
  # / -> /fr/ (302 : la racine choisira la langue quand la version anglaise existera)
  RewriteRule ^(index\.html)?$ https://michelgallone.ch/fr/ [R=302,L]
  # /fr/index.html -> /fr/
  RewriteCond %{THE_REQUEST} \s/(fr|en)/index\.html[\s?#] [NC]
  RewriteRule ^(fr|en)/index\.html$ https://michelgallone.ch/$1/ [R=301,L]
  # /fr -> /fr/
  RewriteRule ^(fr|en)$ https://michelgallone.ch/$1/ [R=301,L]
  # /fr/contact/ -> /fr/contact (sinon les chemins relatifs ../assets se cassent)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(fr|en)/([a-z0-9-]+)/$ https://michelgallone.ch/$1/$2 [R=301,L]
  # Adresses courtes : /fr/contact -> /fr/contact.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(fr|en)/([a-z0-9-]+)$ $1/$2.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml text/vcard
</IfModule>

<IfModule mod_mime.c>
  AddType text/vcard .vcf
  AddCharset utf-8 .vcf
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/xml "access plus 1 day"
  ExpiresByType text/plain "access plus 1 day"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType application/pdf "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  # vCard : jamais indexée, jamais gardée par un cache partagé
  <FilesMatch "\.vcf$">
    Header set X-Robots-Tag "noindex, nofollow, noarchive"
    Header set Cache-Control "private, no-store"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
